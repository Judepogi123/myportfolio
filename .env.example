# Copy to .env and fill in. Values here are committed, so use placeholders only.

# Public — inlined into the bundle, shown on the contact section.
VITE_CONTACT_EMAIL=talkto@thatonedev.com

# Public — the backend the contact form posts to (thatonedev-api).
#
# OPTIONAL. src/lib/api.ts already defaults to the deployed service, so the
# site works with nothing set here. Point it at http://localhost:4000 when
# working on the API locally.
#
# Both SERVICE_ and VITE_ prefixes reach the browser (see envPrefix in
# vite.config.ts) — which means anything behind either is PUBLIC.
SERVICE_API_URL=https://service-production-696e.up.railway.app

# Server-side only. Never give this a VITE_ prefix.
RESEND_API_KEY=
